#!/bin/bash
#
# stumpwm-eval - Evaluate Lisp code in running StumpWM instance
#
# Usage:
#   stumpwm-eval '(+ 1 2)'
#   stumpwm-eval '(window-title (current-window))'
#
# This script uses the file-based eval system in StumpWM.
# Make sure the eval watcher is running in StumpWM first:
#   C-t ; eval-watcher-start

set -euo pipefail

# Configuration
INPUT_FILE="/tmp/stumpwm-eval-input"
OUTPUT_FILE="/tmp/stumpwm-eval-output"
LOCK_FILE="/tmp/stumpwm-eval.lock"
TIMEOUT=10  # seconds to wait for result
POLL_INTERVAL=0.1  # how often to check for output

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

usage() {
    cat << EOF
Usage: stumpwm-eval CODE

Evaluate Lisp code in a running StumpWM instance.

Arguments:
  CODE    Lisp code to evaluate (quoted)

Examples:
  stumpwm-eval '(+ 1 2)'
  stumpwm-eval '(window-title (current-window))'
  stumpwm-eval '(group-windows (current-group))'

Requirements:
  - StumpWM must be running
  - Eval watcher must be started: C-t ; eval-watcher-start

Options:
  -h, --help     Show this help message
  -t TIMEOUT     Timeout in seconds (default: $TIMEOUT)
  -v, --verbose  Verbose output

Exit codes:
  0 - Success
  1 - Error (check output)
  2 - Timeout
  3 - Eval watcher not running

Files:
  Input:  $INPUT_FILE
  Output: $OUTPUT_FILE
  Lock:   $LOCK_FILE
EOF
}

# Parse arguments
VERBOSE=false
CODE=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        -t)
            TIMEOUT="$2"
            shift 2
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        *)
            CODE="$1"
            shift
            ;;
    esac
done

# Validate arguments
if [[ -z "$CODE" ]]; then
    echo -e "${RED}Error: No code provided${NC}" >&2
    echo "Use -h for help" >&2
    exit 1
fi

# Verbose logging
vlog() {
    if $VERBOSE; then
        echo -e "${YELLOW}[DEBUG]${NC} $*" >&2
    fi
}

# Clean up function
cleanup() {
    vlog "Cleaning up..."
    # Don't delete output file - let StumpWM handle it
    # Just remove our input if it's still there
    if [[ -f "$INPUT_FILE" ]]; then
        rm -f "$INPUT_FILE" 2>/dev/null || true
    fi
}

trap cleanup EXIT

# Check if another eval is in progress
if [[ -f "$LOCK_FILE" ]]; then
    # Check if lock is stale (older than 10 seconds)
    if [[ "$(uname)" == "Linux" ]]; then
        LOCK_AGE=$(($(date +%s) - $(stat -c %Y "$LOCK_FILE" 2>/dev/null || echo 0)))
    else
        LOCK_AGE=$(($(date +%s) - $(stat -f %m "$LOCK_FILE" 2>/dev/null || echo 0)))
    fi

    if [[ $LOCK_AGE -lt 10 ]]; then
        vlog "Another eval is in progress, waiting..."
        sleep 1
        if [[ -f "$LOCK_FILE" ]]; then
            echo -e "${RED}Error: Eval system is busy${NC}" >&2
            exit 3
        fi
    else
        vlog "Stale lock file detected, removing..."
        rm -f "$LOCK_FILE" 2>/dev/null || true
    fi
fi

# Remove old output file if it exists
if [[ -f "$OUTPUT_FILE" ]]; then
    vlog "Removing old output file..."
    rm -f "$OUTPUT_FILE" 2>/dev/null || true
fi

# Write code to input file
vlog "Writing code to input file..."
echo "$CODE" > "$INPUT_FILE"

# Wait for output file to appear
vlog "Waiting for result (timeout: ${TIMEOUT}s)..."
ELAPSED=0
while [[ ! -f "$OUTPUT_FILE" ]]; do
    sleep "$POLL_INTERVAL"
    ELAPSED=$(echo "$ELAPSED + $POLL_INTERVAL" | bc)

    # Check if timeout exceeded
    if (( $(echo "$ELAPSED > $TIMEOUT" | bc -l) )); then
        echo -e "${RED}Error: Timeout waiting for result${NC}" >&2
        echo "Possible causes:" >&2
        echo "  - Eval watcher not running (start with: C-t ; eval-watcher-start)" >&2
        echo "  - Code took too long to execute" >&2
        echo "  - StumpWM crashed or frozen" >&2
        exit 2
    fi

    # Check if input file was consumed (StumpWM is processing)
    if [[ ! -f "$INPUT_FILE" ]] && [[ ! -f "$OUTPUT_FILE" ]]; then
        vlog "Input consumed, waiting for output..."
    fi
done

vlog "Result received after ${ELAPSED}s"

# Read and display result
RESULT=$(cat "$OUTPUT_FILE")

# Remove output file
rm -f "$OUTPUT_FILE" 2>/dev/null || true

# Check if result is an error
if [[ "$RESULT" =~ ^ERROR: ]] || [[ "$RESULT" =~ ^READ-ERROR: ]] || [[ "$RESULT" =~ ^EVAL-ERROR: ]]; then
    echo -e "${RED}${RESULT}${NC}" >&2
    exit 1
else
    echo "$RESULT"
    exit 0
fi
